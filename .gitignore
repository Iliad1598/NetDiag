# ============================================================
# .gitignore - NetDiag
# Author: Majid Mousavian Nezhadsadghi
# ============================================================
#
# This file tells Git which files and directories to IGNORE.
# Anything listed here will NOT be uploaded to GitHub.
# ============================================================

# ---- Python bytecode & caches ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ---- Python packaging / build artifacts ----
build/
dist/
*.egg-info/
.eggs/
*.egg

# ---- Virtual environments ----
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ---- IDE / Editor files ----
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject

# ---- Test outputs (generated by NetDiag) ----
netdiag_output.txt
netdiag_output.csv
*_output.txt
*_output.csv
report.txt
report.csv
netdiag_report*.txt
netdiag_report*.csv

# ---- Logs ----
*.log
logs/

# ---- OS-specific files ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ---- Secrets & credentials ----
# NEVER commit tokens, API keys, passwords, or private keys.
*.token
*.key
*.pem
secrets.json
.env
.env.local
config.local.*

# ---- Temporary files ----
*.tmp
*.temp
*.bak
*.orig
*.rej

# ---- Screenshots (temporary, but keep the official one) ----
screenshot_*.png
temp_*.png
*.psd
*.xcf
!Screenshot.png